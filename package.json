{
  "name": "hirmand-real-estate",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "version": "1.0.0",
  "description": "وب‌سایت رسمی گروه مشاورین املاک هیرمند — اصفهان | خرید، فروش، رهن و اجاره",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/validate-deploy-env.mjs && node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "build:web": "node scripts/validate-deploy-env.mjs && node scripts/with-app-env.mjs vite build",
    "db:migrate": "node scripts/migrate.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^5.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@vercel/blob": "^0.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
